APP_NAME="Protejo Mi Mente"
APP_ENV=production
APP_KEY=base64:tSVtWBBFUOKrHtOMmgKf5diJWgrter5TaHRby+L9QQA=
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# Base de Datos (Configuración de Railway)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_DATABASE=${{MYSQLDATABASE}}
DB_USERNAME=${{MYSQLUSER}}
DB_PASSWORD=${{MYSQLPASSWORD}}

# -----------------------------------------------------------------------------
# Drivers (Ajustados para estabilidad en el primer inicio)
# -----------------------------------------------------------------------------
SESSION_DRIVER=cookie
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Otros ajustes
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=error

BCRYPT_ROUNDS=12
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
